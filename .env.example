# Ollama Configuration
OLLAMA_MODEL="gemma2:2b"
OLLAMA_HOST="http://localhost:11434"
OLLAMA_TIMEOUT="600"
OLLAMA_NUM_PREDICT="2048"
OLLAMA_REASONING="false"
OLLAMA_STRIP_THINK="true"

# Embeddings Configuration
EMBEDDING_MODEL="intfloat/multilingual-e5-large"

# Evaluation Configuration
TOP_K="3"
N_URLS_FOR_TOPIC="5"
BATCH_URL="4"

#Device
DEVICE="cpu"

# With Travily Configuration
TAVILY_API_KEY = ""
SEARCH_ENGINE=tavily

# Without Travily Configuration
SEARCH_ENGINE=searxng

SEARXNG_BASE_URL=http://127.0.0.1/searxng
SEARXNG_SEARCH_PATH=/search
SEARXNG_TIMEOUT=30
SEARXNG_CATEGORIES=general
SEARXNG_LANGUAGE=auto
SEARXNG_SAFESEARCH=0
SEARXNG_ENGINES=yandex

SEARCH_ENGINE=newton

NEWTON_BASE_URL=https://newton.psbank.ru
NEWTON_SEARCH_PATH=/api/internal/search/resultByGroups
NEWTON_WHERE=iblock_wiki
NEWTON_ROOT_SECTION_ID=0
NEWTON_TIMEOUT=30
NEWTON_VERIFY_SSL=true

NEWTON_FETCH_FULL_PAGES=true
NEWTON_MAX_PAGE_CHARS=50000

NEWTON_COOKIE=""